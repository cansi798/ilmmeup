---
import Basis from "../layouts/Basis.astro";
import Icon from "../components/Icon.astro";
import Video from "../components/Video.astro";
import Roadmap from "../components/Roadmap.astro";
import SocialBereich from "../components/SocialBereich.astro";
import Newsletter from "../components/Newsletter.astro";
import Figur from "../components/Figur.astro";
import { VIDEOS, TEAM, u } from "../consts";

const themen = ["Gesundheit", "Bildung", "Familie", "Psychologie", "Gesellschaft", "Erziehung", "Wissenschaft", "Glaube & Alltag", "Unternehmertum", "Jugend", "Medizin"];
const saeulen = [
  { icon: "licht", titel: "Wissen sichtbar machen", text: "Fachleute teilen, was sie wissen und erlebt haben – verständlich aufbereitet und hochwertig produziert." },
  { icon: "herz", titel: "Verständnis fördern", text: "Ehrliche Perspektiven und echte Gespräche – für alle, die verstehen wollen." },
  { icon: "personen", titel: "Gemeinschaft stärken", text: "Aus Zuschauern werden Mitwirkende: Wir vernetzen Menschen, die etwas Positives bewegen wollen." },
];
const experten = ["Imame", "Gelehrte", "Ärztinnen & Ärzte", "Psychologinnen & Psychologen", "Pädagoginnen & Pädagogen", "Referentinnen & Referenten", "Unternehmerinnen & Unternehmer", "Autorinnen & Autoren", "Mentorinnen & Mentoren", "Community-Leader"];
---
<Basis>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-licht" aria-hidden="true"><span class="strahl s1"></span><span class="strahl s2"></span><span class="glut"></span></div>
    <div class="huelle hero-raster">
      <div class="hero-text">
        <p class="kicker reveal">Unabhängige Medienplattform</p>
        <h1 class="reveal" style="--v:80ms">Wissen sichtbar machen. <em class="akzent">Menschen verbinden.</em></h1>
        <p class="einleitung reveal" style="--v:160ms">ilm me up gibt Expertinnen, Experten und engagierten Persönlichkeiten eine professionelle Bühne – für Wissen, Erfahrungen und Perspektiven, die Menschen weiterbringen.</p>
        <div class="knopfreihe reveal" style="--v:240ms">
          <a class="knopf" href="#kanaele">Unsere Kanäle <Icon name="pfeil" class="pfeil" /></a>
          <a class="knopf rahmen" href={u("/fuer-experten/")}>Für Experten</a>
        </div>
      </div>
      <div class="hero-videos" aria-label="Aktuelle Videos">
        {VIDEOS.slice(0, 2).map((v, i) => (
          <div class:list={["hero-video reveal", `hv${i}`]} style={`--v:${300 + i * 150}ms`}>
            <Video id={v.id} titel={v.titel} thema={v.thema} variante={i} hoch={v.hoch} />
          </div>
        ))}
      </div>
    </div>
    <div class="themenband" aria-label="Themen">
      <div class="themen-spur">
        {[0, 1].map((k) => (
          <ul aria-hidden={k === 1 ? "true" : undefined}>
            {themen.map((t) => <li>{t}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION -->
  <section class="abschnitt mission">
    <div class="mission-licht" aria-hidden="true"></div>
    <div class="huelle">
      <p class="kicker reveal">Worum es uns geht</p>
      <p class="statement reveal" style="--v:80ms">Wir machen Wissen, Erfahrungen und positive Impulse sichtbar – und schaffen <em class="akzent">Mehrwert für alle wahrheitsliebenden und wissbegierigen Menschen.</em></p>
      <ol class="saeulen reveal" data-bahn data-bahn-min="900" data-bahn-farbe="#ffc400">
        {saeulen.map((s, i) => (
          <li class="saeule" style={`--v:${300 + i * 380}ms; --i:${i}`}>
            <span class="saeule-icon" data-knoten><Icon name={s.icon} /></span>
            <div class="saeule-karte">
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="reveal mehr"><a class="textlink" href={u("/vision/")}>Unsere Vision & Werte <Icon name="pfeil" /></a></p>
    </div>
  </section>

  <!-- FÜR EXPERTEN -->
  <section class="abschnitt dunkel experten">
    <div class="huelle experten-raster">
      <div>
        <p class="kicker reveal">Für Expertinnen & Experten</p>
        <h2 class="reveal">Wissen verdient eine <em class="akzent">Bühne.</em></h2>
        <p class="einleitung reveal">Unser Team übernimmt Planung, Dreh, Schnitt und Veröffentlichung – kostenlos. Für Fachleute, die ihr Wissen teilen und Menschen positiv erreichen möchten.</p>
        <ul class="vorteile reveal">
          <li><Icon name="haken" />Kostenfreie professionelle Videoproduktion</li>
          <li><Icon name="haken" />Reichweite über YouTube, Instagram und TikTok</li>
          <li><Icon name="haken" />Unabhängig, respektvoll und offen für alle</li>
        </ul>
        <div class="knopfreihe reveal"><a class="knopf" href={u("/fuer-experten/#anfrage")}>Kooperation anfragen <Icon name="pfeil" class="pfeil" /></a></div>
      </div>
      <div class="experten-wolke reveal" aria-label="Wen wir suchen">
        <ul class="chips">
          {experten.map((e, i) => <li style={`--i:${i}`}>{e}</li>)}
          <li class="weitere" style={`--i:${experten.length}`}>und weitere</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="abschnitt">
    <div class="huelle">
      <div class="kopfzeile zweispaltig">
        <div>
          <p class="kicker reveal">Das Team</p>
          <h2 class="reveal">Menschen mit Beruf, Erfahrung <em class="akzent">und Haltung.</em></h2>
        </div>
        <p class="einleitung reveal">Ärztinnen und Ärzte, Naturwissenschaft, Technik und Video: Hinter ilm me up steht ein Team beruflich etablierter Menschen, die ihr Können gemeinsam einbringen.</p>
      </div>
      <ul class="team-reihe">
        {TEAM.map((p, i) => (
          <li class="reveal" style={`--v:${i * 60}ms`}>
            <Figur figur={p.figur} name={p.name} hinter={i} />
            <strong>{p.name}</strong>
            <span>{p.rolle}</span>
          </li>
        ))}
      </ul>
      <p class="reveal mehr"><a class="textlink" href={u("/ueber-uns/#team")}>Das ganze Team kennenlernen <Icon name="pfeil" /></a></p>
    </div>
  </section>

  <!-- SOCIAL -->
  <section class="abschnitt weiss" id="kanaele">
    <div class="huelle">
      <div class="kopfzeile zweispaltig">
        <div>
          <p class="kicker reveal">Folge uns</p>
          <h2 class="reveal">Dort, wo du <em class="akzent">zuschaust.</em></h2>
        </div>
        <p class="einleitung reveal">Neue Videos erscheinen laufend auf unseren Kanälen. Folge uns und sei bei jedem neuen Impuls dabei.</p>
      </div>
      <SocialBereich />
    </div>
  </section>

  <!-- WAS ENTSTEHT -->
  <section class="abschnitt dunkel entsteht">
    <div class="huelle">
      <div class="kopfzeile zweispaltig">
        <div>
          <p class="kicker reveal">Was entsteht</p>
          <h2 class="reveal">Die Medienplattform ist <em class="akzent">der erste Schritt.</em></h2>
        </div>
        <p class="einleitung reveal">Heute bauen wir Reichweite, Vertrauen und Gemeinschaft auf. Daraus soll eine nachhaltige Infrastruktur für Bildung, Vernetzung und gesellschaftlichen Mehrwert wachsen.</p>
      </div>
      <Roadmap />
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="abschnitt eng">
    <div class="huelle"><Newsletter /></div>
  </section>
</Basis>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; background: var(--nacht); color: rgba(255, 255, 255, 0.82); padding-top: clamp(7rem, 14vw, 9rem); isolation: isolate; }
  .hero h1 { color: #fff; max-width: 13ch; }
  .hero-raster { display: grid; gap: 3rem; align-items: center; padding-bottom: clamp(3rem, 7vw, 5rem); }
  @media (min-width: 960px) { .hero-raster { grid-template-columns: 1.15fr 1fr; min-height: min(78vh, 720px); } }
  .hero .einleitung { max-width: 44ch; margin-bottom: 2rem; color: rgba(255, 255, 255, 0.9); }
  @media (max-width: 959px) { .glut { width: 620px; height: 620px; right: -300px; top: -260px; opacity: 0.7; } .strahl { opacity: 0.5; } }
  .hero-licht { position: absolute; inset: 0; z-index: -1; }
  .glut { position: absolute; width: 900px; height: 900px; right: -220px; top: -180px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 204, 0, 0.28), rgba(0, 103, 128, 0.35) 35%, transparent 66%); animation: atmen 9s ease-in-out infinite alternate; }
  .strahl { position: absolute; top: -20%; height: 140%; width: 34vw; background: linear-gradient(180deg, rgba(255, 230, 128, 0.12), transparent 70%); filter: blur(30px); transform-origin: top center; }
  .s1 { right: 18%; transform: rotate(18deg); animation: wiegen 12s ease-in-out infinite alternate; }
  .s2 { right: 2%; transform: rotate(-12deg); animation: wiegen 15s ease-in-out infinite alternate-reverse; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.03) 0 1px, transparent 1px 96px); mask-image: linear-gradient(to bottom, #000 30%, transparent); }
  @keyframes atmen { to { transform: scale(1.12) translate(-30px, 20px); opacity: 0.85; } }
  @keyframes wiegen { to { transform: rotate(4deg); } }

  .hero-videos { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 520px; width: 100%; justify-self: center; }
  .hero-video :global(.video-rahmen) { border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7); }
  .hero-video :global(.video-titel) { color: #fff; font-size: 1rem; }
  .hero-video :global(.video-thema) { color: var(--gelb); }
  @media (min-width: 960px) {
    .hv0 { transform: translateY(-1.5rem); }
    .hv1 { transform: translateY(2.5rem); }
    .js .hv0.reveal:not(.sichtbar) { transform: translateY(1rem); }
    .js .hv1.reveal:not(.sichtbar) { transform: translateY(5rem); }
  }

  .themenband { border-block: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.03); overflow: hidden; padding-block: 0.9rem; }
  .themen-spur { display: flex; width: max-content; animation: laufen 48s linear infinite; }
  .themenband:hover .themen-spur { animation-play-state: paused; }
  .themen-spur ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .themen-spur li { display: flex; align-items: center; gap: 1.8rem; padding-right: 1.8rem; font-weight: 700; font-size: clamp(0.88rem, 1.5vw, 1.15rem); letter-spacing: -0.02em; color: rgba(255, 255, 255, 0.85); white-space: nowrap; }
  .themen-spur li::after { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--gelb); }
  @keyframes laufen { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .themen-spur { animation: none; flex-wrap: wrap; width: auto; } .themen-spur ul + ul { display: none; } .themen-spur ul { flex-wrap: wrap; padding-inline: var(--rand); row-gap: 0.5rem; } }

  /* Mission */
  .statement { font-family: var(--sans); font-weight: 700; font-size: clamp(1.7rem, 3.6vw, 3rem); line-height: 1.22; letter-spacing: -0.03em; color: var(--tinte); max-width: 26ch; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  /* Mission: Hervorhebung „malt“ sich beim Einblenden in Petrol */
  .mission { overflow: hidden; }
  .mission-licht { position: absolute; width: 760px; height: 760px; right: -260px; top: -220px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 204, 0, 0.22), rgba(255, 204, 0, 0) 62%); pointer-events: none; animation: atmen 10s ease-in-out infinite alternate; }
  @media (max-width: 899px) { .mission-licht { width: 420px; height: 420px; right: -220px; top: -140px; opacity: 0.7; } }
  .statement :global(em.akzent) { background: linear-gradient(90deg, var(--petrol) 0 50%, rgba(14, 42, 51, 0.18) 50% 100%); background-size: 200% 100%; background-position: 0 0; -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-box-decoration-break: clone; box-decoration-break: clone; transition: background-position 1.6s var(--kurve) 0.5s; }
  :global(.js) .statement.reveal:not(.sichtbar) :global(em.akzent) { background-position: 100% 0; }

  /* Drei Säulen: verbundene Stationen mit glimmenden Symbolen (Bildsprache wie Zeitleiste/Ablauf) */
  .saeulen { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 1.5rem; }
  .saeulen::before, .saeulen::after { content: ""; position: absolute; pointer-events: none; }
  .saeulen::before { background: linear-gradient(var(--gelb), rgba(0, 103, 128, 0.25)); transform-origin: top center; transition: transform 1.6s var(--kurve) 0.2s; left: 35px; top: 36px; bottom: 36px; width: 2px; }
  .saeulen::after { left: 34px; top: 36px; bottom: 36px; width: 4px; border-radius: 2px; filter: drop-shadow(0 0 4px rgba(255, 204, 0, 0.7)); background: linear-gradient(180deg, transparent, rgba(255, 230, 128, 1), transparent) no-repeat; background-size: 100% 26%; background-position: 0 -40%; animation: s-glanz-y 6s cubic-bezier(0.45, 0, 0.25, 1) 2s infinite; }
  :global(.js) .saeulen.reveal:not(.sichtbar)::before { transform: scaleY(0); }
  .saeule { position: relative; display: grid; grid-template-columns: 72px 1fr; gap: 1.1rem; align-items: start; align-content: start; }
  .saeule-icon { position: relative; z-index: 1; width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: var(--weiss); color: var(--petrol); border: 2px solid rgba(0, 103, 128, 0.18); box-shadow: var(--schatten); transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.35s, color 0.35s, border-color 0.35s, opacity 0.4s; transition-delay: var(--v), 0s, 0s, 0s, var(--v); }
  .saeule-icon :global(svg) { width: 30px; height: 30px; }
  .saeule-icon::before { content: ""; position: absolute; inset: 0; border-radius: 50%; z-index: -1; background: radial-gradient(circle, rgba(255, 220, 90, 0.75), rgba(255, 204, 0, 0) 70%); opacity: 0; animation: s-glimmen 4.8s ease-in-out infinite; animation-delay: calc(var(--i) * 1.2s + 2s); }
  .saeule-icon::after { content: ""; position: absolute; inset: -2px; border-radius: 50%; border: 2px solid rgba(255, 204, 0, 0.65); opacity: 0; animation: s-welle 4.8s ease-out infinite; animation-delay: calc(var(--i) * 1.2s + 2s); }
  :global(.js) .saeulen.reveal:not(.sichtbar) .saeule-icon { transform: scale(0.3); opacity: 0; }
  .saeule-karte { position: relative; overflow: hidden; background: var(--weiss); border-radius: var(--radius); padding: 1.5rem 1.6rem 1.6rem; box-shadow: var(--schatten); border: 1px solid rgba(14, 42, 51, 0.05); transition: transform 0.45s var(--kurve), box-shadow 0.45s, opacity 0.8s var(--kurve); transition-delay: 0s, 0s, calc(var(--v) + 150ms); }
  .saeule-karte::before { content: ""; position: absolute; left: 0; top: 0; height: 4px; width: 100%; background: linear-gradient(90deg, var(--gelb), var(--gelb-hell)); transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--kurve); }
  .saeule-karte::after { content: ""; position: absolute; width: 220px; height: 220px; right: -90px; bottom: -110px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 204, 0, 0.35), transparent 65%); opacity: 0; transition: opacity 0.5s; }
  :global(.js) .saeulen.reveal:not(.sichtbar) .saeule-karte { opacity: 0; transform: translateY(24px); }
  .saeule h3 { margin-bottom: 0.45rem; font-size: clamp(1.25rem, 1.9vw, 1.5rem); }
  .saeule p { margin: 0; color: var(--leise); position: relative; }
  .saeule:hover .saeule-karte { transform: translateY(-6px); box-shadow: 0 24px 50px -24px rgba(4, 35, 45, 0.35); }
  .saeule:hover .saeule-karte::before { transform: scaleX(1); }
  .saeule:hover .saeule-karte::after { opacity: 1; }
  .saeule:hover .saeule-icon { background: var(--gelb); color: var(--tinte); border-color: var(--gelb); transform: scale(1.06); }
  @media (min-width: 900px) {
    .saeulen { grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
    .saeulen::before { left: calc(50% - 50vw); right: calc(50% - 50vw); top: 35px; bottom: auto; width: auto; height: 2px; background: linear-gradient(90deg, rgba(255, 204, 0, 0.35), var(--gelb) 20%, rgba(0, 103, 128, 0.3) 80%, rgba(0, 103, 128, 0.12)); transform-origin: left center; }
    :global(.js) .saeulen.reveal:not(.sichtbar)::before { transform: scaleX(0); }
    .saeulen::after { left: calc(50% - 50vw); right: calc(50% - 50vw); top: 34px; bottom: auto; height: 4px; width: auto; background: linear-gradient(90deg, transparent, rgba(255, 230, 128, 1), transparent) no-repeat; background-size: 14% 100%; background-position: -20% 0; animation-name: s-glanz-x; animation-duration: 7s; }
    .saeule { grid-template-columns: 1fr; gap: 1.4rem; }
  }
  @keyframes s-glimmen { 0%, 40%, 100% { opacity: 0; transform: scale(1.3); } 15% { opacity: 1; transform: scale(1.9); } }
  @keyframes s-welle { 0% { opacity: 0.8; transform: scale(1); } 25%, 100% { opacity: 0; transform: scale(1.7); } }
  @keyframes s-glanz-x { 0% { background-position: -20% 0; } 80%, 100% { background-position: 120% 0; } }
  @keyframes s-glanz-y { 0% { background-position: 0 -40%; } 75%, 100% { background-position: 0 140%; } }
  @media (prefers-reduced-motion: reduce) { .saeulen::after, .saeule-icon::before, .saeule-icon::after, .mission-licht { animation: none; } }
  .mehr { margin: 2.5rem 0 0; }


  /* Experten */
  .experten { overflow: hidden; }
  .experten::before { content: ""; position: absolute; width: 760px; height: 760px; left: -280px; bottom: -420px; border-radius: 50%; background: radial-gradient(circle, rgba(0, 103, 128, 0.75), transparent 65%); }
  .experten-raster { position: relative; display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .experten-raster { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .vorteile { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 0.7rem; }
  .vorteile li { display: flex; gap: 0.75rem; align-items: flex-start; color: #fff; font-weight: 600; }
  .vorteile :global(svg) { width: 22px; height: 22px; flex: none; padding: 3px; border-radius: 50%; background: var(--gelb); color: var(--tinte); stroke-width: 3; margin-top: 0.15rem; }
  .experten-wolke .chips { gap: 0.7rem; }
  .experten-wolke .chips li { font-size: clamp(0.95rem, 1.4vw, 1.1rem); padding: 0.7em 1.2em; animation: schwebe 6s ease-in-out infinite; animation-delay: calc(var(--i) * -0.7s); }
  .experten-wolke .chips li.weitere { background: transparent; border-color: transparent; color: rgba(255, 255, 255, 0.75); font-weight: 600; }
  @keyframes schwebe { 50% { transform: translateY(-6px); } }

  /* Team */
  .team-reihe { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  @media (min-width: 640px) { .team-reihe { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1100px) { .team-reihe { grid-template-columns: repeat(8, 1fr); } }
  .team-reihe li { display: grid; justify-items: center; text-align: center; gap: 0.15rem; }
  .team-reihe :global(.figur) { width: min(100%, 140px); margin-bottom: 0.6rem; border-radius: 50%; transition: transform 0.4s var(--kurve); }
  .team-reihe li:hover :global(.figur) { transform: translateY(-4px) rotate(-3deg); }
  .team-reihe strong { color: var(--tinte); font-size: 1.05rem; }
  .team-reihe span { font-size: 0.88rem; color: var(--leise); line-height: 1.35; }
</style>
