---
// Ansprache auf dieser Seite: „Sie“ (Fachpublikum). Übrige Seiten: „du“ (Community).
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Icon from "../components/Icon.astro";
import FormularSkript from "../components/FormularSkript.astro";
import { MAIL, u } from "../consts";
const leistungen = [
  { icon: "kompass", titel: "Konzept & Vorbereitung", text: "Wir entwickeln mit Ihnen Thema, Format und Ablauf – Sie bringen das Wissen mit, wir den Rahmen." },
  { icon: "kamera", titel: "Professioneller Dreh", text: "Kamera, Licht und Ton von unserem eigenen Produktionsteam – bei uns oder an einem passenden Ort." },
  { icon: "schnitt", titel: "Schnitt & Gestaltung", text: "Sorgfältiger Schnitt, Untertitel und Kurzfassungen für Social Media – im einheitlichen Look von ilm me up." },
  { icon: "netz", titel: "Veröffentlichung & Reichweite", text: "Wir veröffentlichen auf YouTube, Instagram und TikTok und machen Ihre Inhalte für viele Menschen sichtbar." },
];
const schritte = [
  ["Anfrage senden", "Erzählen Sie uns kurz, wer Sie sind und welches Thema Ihnen am Herzen liegt."],
  ["Kennenlernen", "In einem unverbindlichen Gespräch klären wir Idee, Format und Erwartungen."],
  ["Aufnahme", "Wir planen den Dreh gemeinsam und produzieren in entspannter Atmosphäre."],
  ["Veröffentlichung", "Sie erhalten die Inhalte vorab zur Freigabe – danach gehen sie online."],
];
const fachgebiete = ["Imam / Gelehrte(r)", "Medizin", "Psychologie / Psychotherapie", "Pädagogik / Bildung", "Unternehmertum / Wirtschaft", "Autorin / Autor", "Mentoring / Coaching", "Community-Arbeit / Ehrenamt", "Anderes Fachgebiet"];
const fragen = [
  ["Was kostet die Zusammenarbeit?", "Die Zusammenarbeit ist für Sie kostenlos: Produktion und Veröffentlichung übernehmen wir, die Plattform finanzieren wir selbst. Unser Ziel ist gesellschaftlicher Mehrwert."],
  ["Brauche ich Erfahrung vor der Kamera?", "Wir bereiten Sie gut vor und nehmen uns Zeit – gerade dann, wenn Sie zum ersten Mal vor der Kamera stehen."],
  ["Wer entscheidet über die Inhalte?", "Wir stimmen Thema und Ablauf gemeinsam ab. Vor der Veröffentlichung sehen Sie das Ergebnis und geben es frei."],
  ["Wie ist ilm me up ausgerichtet?", "ilm me up ist unabhängig, überparteilich und offen für Menschen aller Richtungen. Respektvoller Umgang ist für uns Grundlage."],
];
---
<Basis titel="Für Experten" beschreibung="Kostenlose professionelle Videoproduktion für Expertinnen und Experten: Teilen Sie Ihr Wissen auf der Medienplattform ilm me up.">
  <SeitenKopf kicker="Für Expertinnen & Experten" titel='Ihr Wissen. <em class="akzent">Unsere Bühne.</em>' einleitung="Sie haben Wissen und Erfahrung, die Menschen weiterbringen? Wir produzieren und veröffentlichen Ihre Inhalte professionell – als kostenlose Dienstleistung unserer Videoplattform.">
    <div class="knopfreihe kopf-knoepfe">
      <a class="knopf" href="#anfrage">Jetzt anfragen <Icon name="pfeil" class="pfeil" /></a>
      <a class="knopf rahmen" href="#ablauf">So läuft es ab</a>
    </div>
  </SeitenKopf>

  <section class="abschnitt">
    <div class="huelle">
      <div class="kopfzeile zweispaltig">
        <div>
          <p class="kicker reveal">Was wir für Sie übernehmen</p>
          <h2 class="reveal">Sie sprechen. <em class="akzent">Wir kümmern uns um den Rest.</em></h2>
        </div>
        <p class="einleitung reveal">Von der ersten Idee bis zum fertigen Video: Unser Team bringt Medienkompetenz und eigene Videoproduktion mit.</p>
      </div>
      <div class="raster vier">
        {leistungen.map((l, i) => (
          <article class="karte reveal" style={`--v:${i * 80}ms`}>
            <div class="symbol"><Icon name={l.icon} /></div>
            <h3>{l.titel}</h3>
            <p class="leise">{l.text}</p>
          </article>
        ))}
      </div>
      <div class="kostenlos reveal">
        <span class="kostenlos-wert">0 €</span>
        <p><strong>Kostenlos für Sie.</strong> Wir finanzieren die Plattform selbst und verstehen ilm me up als Beitrag für die Gesellschaft. Sie investieren Ihr Wissen und Ihre Zeit – um alles andere kümmern wir uns.</p>
      </div>
    </div>
  </section>

  <section class="abschnitt dunkel" id="ablauf">
    <div class="huelle">
      <p class="kicker reveal">Ablauf</p>
      <h2 class="reveal">In vier Schritten <em class="akzent">zu Ihrem Beitrag.</em></h2>
      <ol class="schritte" data-bahn>
        {schritte.map(([t, s], i) => (
          <li class="reveal schritt" style={`--v:${i * 380}ms; --i:${i}`}>
            <span class="schritt-nr" data-knoten>{i + 1}</span>
            <h3>{t}</h3>
            <p>{s}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="abschnitt weiss" id="anfrage">
    <div class="huelle anfrage-raster">
      <div class="anfrage-text">
        <p class="kicker reveal">Kooperationsanfrage</p>
        <h2 class="reveal">Lassen Sie uns <em class="akzent">sprechen.</em></h2>
        <p class="reveal">Wir freuen uns über Anfragen von Imamen, Gelehrten, Referentinnen und Referenten, Pädagoginnen und Pädagogen, Psychologinnen und Psychologen, Ärztinnen und Ärzten, Unternehmerinnen und Unternehmern, Autorinnen und Autoren, Mentorinnen und Mentoren sowie Community-Leadern.</p>
        <p class="reveal leise">Wir melden uns so bald wie möglich bei Ihnen. Lieber direkt per E-Mail? <a href={`mailto:${MAIL}`}>{MAIL}</a></p>
        <div class="faq reveal">
          {fragen.map(([f, a]) => (
            <details>
              <summary>{f}<Icon name="plus" /></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
      <div class="formular-karte reveal">
        <form class="formular" data-mailto={MAIL} data-betreff="Kooperationsanfrage Experte" novalidate>
          <div class="feldgruppe zwei">
            <div class="feld">
              <label for="e-name">Name <span class="pflicht">*</span></label>
              <input id="e-name" name="name" type="text" autocomplete="name" required />
              <span class="fehler">Bitte geben Sie Ihren Namen an.</span>
            </div>
            <div class="feld">
              <label for="e-mail">E-Mail <span class="pflicht">*</span></label>
              <input id="e-mail" name="email" type="email" autocomplete="email" required />
              <span class="fehler">Bitte geben Sie eine gültige E-Mail-Adresse an.</span>
            </div>
          </div>
          <div class="feldgruppe zwei">
            <div class="feld">
              <label for="e-fach">Fachgebiet <span class="pflicht">*</span></label>
              <select id="e-fach" name="fachgebiet" required>
                <option value="">Bitte wählen</option>
                {fachgebiete.map((f) => <option>{f}</option>)}
              </select>
              <span class="fehler">Bitte wählen Sie ein Fachgebiet.</span>
            </div>
            <div class="feld">
              <label for="e-tel">Telefon</label>
              <input id="e-tel" name="telefon" type="tel" autocomplete="tel" />
              <span class="hilfe">Optional – für eine schnelle Rückmeldung.</span>
            </div>
          </div>
          <div class="feld">
            <label for="e-beruf">Beruf / Tätigkeit <span class="pflicht">*</span></label>
            <input id="e-beruf" name="beruf" type="text" placeholder="z. B. Fachärztin für Kinderheilkunde" required />
            <span class="fehler">Bitte beschreiben Sie kurz Ihre Tätigkeit.</span>
          </div>
          <div class="feld">
            <label for="e-thema">Themenidee <span class="pflicht">*</span></label>
            <textarea id="e-thema" name="thema" rows="5" placeholder="Worüber möchten Sie sprechen? Für wen ist das Thema wichtig?" required minlength="20"></textarea>
            <span class="fehler">Bitte beschreiben Sie Ihre Idee in ein paar Sätzen (mind. 20 Zeichen).</span>
          </div>
          <div class="feld">
            <label for="e-links">Website oder Social-Media-Profil</label>
            <input id="e-links" name="links" type="text" placeholder="Optional" />
          </div>
          <label class="haken feld-haken">
            <input type="checkbox" name="einwilligung" required />
            <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden. Mehr in der <a href={u("/datenschutz/")}>Datenschutzerklärung</a>. <span class="pflicht">*</span><span class="fehler">Bitte bestätigen Sie die Einwilligung.</span></span>
          </label>
          <button class="knopf petrol-knopf senden" type="submit">Anfrage senden <Icon name="pfeil" class="pfeil" /></button>
          <p class="formular-info"><Icon name="mail" /> Beim Senden öffnet sich Ihr E-Mail-Programm mit der vorbereiteten Nachricht an {MAIL}.</p>
        </form>
        <div class="formular-ok" tabindex="-1" role="status">
          <strong>Fast geschafft!</strong>
          Ihr E-Mail-Programm sollte sich jetzt mit der vorbereiteten Nachricht öffnen – bitte dort noch auf „Senden“ klicken. Alternativ: <a data-mailto-link href={`mailto:${MAIL}`}>E-Mail manuell öffnen</a> oder direkt an {MAIL} schreiben.
        </div>
      </div>
    </div>
  </section>
  <FormularSkript />
</Basis>

<style>
  .kopf-knoepfe { margin-top: 2rem; }
  .leise { color: var(--leise); margin: 0; }
  .kostenlos { margin-top: clamp(2rem, 4vw, 3rem); display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; padding: 1.75rem 2rem; border-radius: var(--radius); background: var(--gelb); color: var(--tinte); }
  .kostenlos-wert { font-weight: 800; font-size: clamp(2.6rem, 5vw, 3.6rem); letter-spacing: -0.05em; line-height: 1; }
  .kostenlos p { margin: 0; max-width: 60ch; flex: 1 1 280px; }
  .schritte { list-style: none; padding: 0; margin: clamp(2.5rem, 5vw, 4rem) 0 0; display: grid; gap: 1.5rem; counter-reset: s; }
  @media (min-width: 800px) { .schritte { grid-template-columns: repeat(4, 1fr); } }
  .schritte li { position: relative; padding-top: 1rem; border-top: 2px solid rgba(255, 255, 255, 0.15); }
  /* Ablauf-Animation: Linie zeichnet sich Schritt für Schritt, Nummern ploppen auf und glimmen nacheinander */
  .schritte li::before { content: ""; position: absolute; left: 0; right: 0; top: -2px; height: 2px; background: linear-gradient(90deg, var(--gelb), var(--gelb-hell)); box-shadow: 0 0 10px rgba(255, 204, 0, 0.55); transform-origin: left center; transition: transform 0.9s var(--kurve); transition-delay: calc(var(--v) + 150ms); }
  :global(.js) .schritte li.reveal:not(.sichtbar)::before { transform: scaleX(0); }
  @media (min-width: 800px) {
    .schritte { position: relative; }
    .schritte li { border-top: 0; padding-top: 0; }
    .schritte li::before { top: 25px; }
    .schritte .schritt-nr { margin-top: 0; }
    .schritte li:not(:last-child)::before { right: -1.5rem; }
    .schritte::before, .schritte::after { content: ""; position: absolute; left: calc(50% - 50vw); right: calc(50% - 50vw); pointer-events: none; }
    .schritte::before { top: 25px; height: 2px; background: rgba(255, 255, 255, 0.15); }
    .schritte::after { top: 24px; height: 4px; z-index: 1; filter: drop-shadow(0 0 4px rgba(255, 220, 90, 0.7)); background: linear-gradient(90deg, transparent, rgba(255, 240, 180, 1), transparent) no-repeat; background-size: 14% 100%; background-position: -20% 0; animation: ab-glanz 7s cubic-bezier(0.45, 0, 0.25, 1) 2.5s infinite; }
  }
  /* Handy: Schritte untereinander an einer senkrechten Linie durch die Nummernkreise */
  @media (max-width: 799px) {
    .schritte { position: relative; gap: 2rem; }
    .schritte::before { content: ""; position: absolute; left: 25px; top: 26px; bottom: 26px; width: 2px; background: rgba(255, 255, 255, 0.15); }
    .schritte li { display: grid; grid-template-columns: 52px minmax(0, 1fr); column-gap: 1.1rem; border-top: 0; padding-top: 0; }
    .schritte .schritt-nr { grid-row: span 2; margin: 0; }
    .schritte li h3 { margin: 0.7rem 0 0.4rem; }
    .schritte li::before { left: 25px; right: auto; top: 26px; bottom: auto; width: 2px; height: calc(100% + 2rem); transform-origin: center top; background: linear-gradient(180deg, var(--gelb), var(--gelb-hell)); }
    .schritte li:last-child::before { display: none; }
    :global(.js) .schritte li.reveal:not(.sichtbar)::before { transform: scaleY(0); }
  }
  @keyframes ab-glanz { 0% { background-position: -20% 0; } 80%, 100% { background-position: 120% 0; } }
  @media (prefers-reduced-motion: reduce) { .schritte::after { animation: none; display: none; } }
  .schritt-nr { position: relative; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--gelb); color: var(--tinte); font-weight: 800; font-size: 1.3rem; margin: 0.5rem 0 1.2rem; box-shadow: 0 0 12px 2px rgba(255, 204, 0, 0.45); transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s; transition-delay: calc(var(--v) + 250ms); }
  :global(.js) .schritte li.reveal:not(.sichtbar) .schritt-nr { transform: scale(0.3); opacity: 0; }
  .schritt-nr::before { content: ""; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, rgba(255, 220, 90, 0.7), rgba(255, 204, 0, 0) 70%); z-index: -1; opacity: 0; animation: nr-glimmen 4.8s ease-in-out infinite; animation-delay: calc(var(--i) * 1.2s + 1.6s); }
  .schritt-nr::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(255, 204, 0, 0.6); opacity: 0; animation: nr-welle 4.8s ease-out infinite; animation-delay: calc(var(--i) * 1.2s + 1.6s); }
  @keyframes nr-glimmen { 0%, 40%, 100% { opacity: 0; transform: scale(1.4); } 15% { opacity: 1; transform: scale(2.1); } }
  @keyframes nr-welle { 0% { opacity: 0.8; transform: scale(1); } 25%, 100% { opacity: 0; transform: scale(1.9); } }
  @media (prefers-reduced-motion: reduce) { .schritt-nr::before, .schritt-nr::after { animation: none; } }
  .schritte p { color: rgba(255, 255, 255, 0.72); margin: 0; }
  .anfrage-raster { display: grid; gap: 3rem; }
  @media (min-width: 1000px) { .anfrage-raster { grid-template-columns: 1fr 1.15fr; gap: 4.5rem; align-items: start; } .anfrage-text { position: sticky; top: 110px; } }
  .formular-karte { background: var(--papier); border-radius: var(--radius-gross); padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--linie); }
  .feld-haken .fehler { display: none; color: #b42318; font-weight: 600; font-size: 0.88rem; margin-top: 0.3rem; }
  .feld-haken.ungueltig .fehler { display: block; }
  .senden { justify-self: start; }
  .formular-info { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.88rem; color: var(--leise); margin: 0; }
  .formular-info :global(svg) { width: 18px; height: 18px; flex: none; margin-top: 0.2rem; }
  .faq { margin-top: 2rem; border-top: 1px solid var(--linie); }
  .faq details { border-bottom: 1px solid var(--linie); }
  .faq summary { list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1.1rem 0; font-weight: 700; color: var(--tinte); cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(svg) { width: 20px; height: 20px; flex: none; color: var(--petrol); transition: transform 0.3s var(--kurve); }
  .faq details[open] summary :global(svg) { transform: rotate(45deg); }
  .faq details p { color: var(--leise); margin: 0 0 1.2rem; }
</style>
