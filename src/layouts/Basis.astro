---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BESCHREIBUNG, NAME, VORSCHAU, u } from "../consts";
import fontJakarta from "../styles/fonts/plus-jakarta-sans-latin-800-normal.woff2?url";
import fontJakarta4 from "../styles/fonts/plus-jakarta-sans-latin-400-normal.woff2?url";
interface Props { titel?: string; beschreibung?: string }
const { titel, beschreibung = BESCHREIBUNG } = Astro.props;
const voll = titel ? `${titel} · ${NAME}` : `${NAME} – Wissen sichtbar machen`;
const kanon = new URL(Astro.url.pathname, Astro.site);
const og = new URL(u("/assets/og-image.jpg"), Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{voll}</title>
    <meta name="description" content={beschreibung} />
    {VORSCHAU && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={kanon} />
    <meta name="theme-color" content="#04232d" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={u("/assets/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={u("/assets/apple-touch-icon.png")} />
    <link rel="preload" href={fontJakarta} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontJakarta4} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={voll} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <script>
      // Kopfzeile beim Scrollen verfestigen
      const kopf = document.querySelector<HTMLElement>("[data-kopf]");
      const pruefen = () => kopf?.classList.toggle("fest", scrollY > 24);
      addEventListener("scroll", pruefen, { passive: true });
      pruefen();

      // Mobiles Menü
      const knopf = document.querySelector<HTMLButtonElement>("[data-menue]");
      const nav = document.getElementById("mobilnav");
      const setzen = (auf: boolean) => {
        if (!knopf || !nav) return;
        knopf.setAttribute("aria-expanded", String(auf));
        nav.hidden = !auf;
        kopf?.classList.toggle("offen", auf);
        document.body.style.overflow = auf ? "hidden" : "";
      };
      knopf?.addEventListener("click", () => setzen(knopf.getAttribute("aria-expanded") !== "true"));
      addEventListener("keydown", (e) => { if (e.key === "Escape") setzen(false); });
      matchMedia("(min-width: 1081px)").addEventListener("change", (m) => m.matches && setzen(false));

      // Sanftes Einblenden beim Scrollen
      const elemente = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver((eintraege) => {
          for (const e of eintraege) if (e.isIntersecting) { e.target.classList.add("sichtbar"); io.unobserve(e.target); }
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        elemente.forEach((el) => io.observe(el));
      } else elemente.forEach((el) => el.classList.add("sichtbar"));

      // Lichtbahn: Ein Lichtblitz läuft über die volle Breite der Linie, teilt sich an jedem Kreis
      // in zwei Hälften (oben/unten um den Kreis), trifft sich dahinter wieder und läuft weiter.
      // Kreise leuchten kurz auf, wenn das Licht sie erreicht. Nur Desktop, nicht bei reduzierter Bewegung.
      const SVGNS = "http://www.w3.org/2000/svg";
      const bahnen = [...document.querySelectorAll<HTMLElement>("[data-bahn]")];
      const ruhig = matchMedia("(prefers-reduced-motion: reduce)");
      const DAUER = 7000, STRICH = 110;
      const bahnBauen = (bahn: HTMLElement) => {
        bahn.querySelector(":scope > .lichtbahn")?.remove();
        bahn.classList.remove("bahn-aktiv");
        const min = Number(bahn.dataset.bahnMin || 0);
        if (ruhig.matches || innerWidth < min) return;
        const box = bahn.getBoundingClientRect();
        const knoten = [...bahn.querySelectorAll<HTMLElement>("[data-knoten]")].map((k) => {
          const r = k.getBoundingClientRect();
          // ohne Skalierung durch Einblend-Animation messen
          const w = k.offsetWidth;
          return { cx: r.left + r.width / 2 - box.left, cy: r.top + r.height / 2 - box.top, r: w / 2 + 1 };
        });
        if (!knoten.length) return;
        const y = knoten[0].cy;
        const x0 = -box.left, x1 = innerWidth - box.left;
        const pfad = (oben: boolean) => {
          let d = `M ${x0} ${y}`;
          for (const k of knoten) d += ` H ${k.cx - k.r} A ${k.r} ${k.r} 0 0 ${oben ? 1 : 0} ${k.cx + k.r} ${y}`;
          return d + ` H ${x1}`;
        };
        const svg = document.createElementNS(SVGNS, "svg");
        svg.classList.add("lichtbahn");
        svg.setAttribute("width", String(box.width)); svg.setAttribute("height", String(box.height));
        svg.setAttribute("aria-hidden", "true");
        svg.innerHTML = `<defs><radialGradient id="lg-${bahnen.indexOf(bahn)}"><stop offset="0" stop-color="#ffe680" stop-opacity="0.85"/><stop offset="1" stop-color="#ffcc00" stop-opacity="0"/></radialGradient>
          <filter id="lf-${bahnen.indexOf(bahn)}" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>`;
        const gesamt: number[] = [];
        for (const oben of [true, false]) {
          const p = document.createElementNS(SVGNS, "path");
          p.setAttribute("d", pfad(oben));
          p.setAttribute("fill", "none");
          p.setAttribute("stroke", bahn.dataset.bahnFarbe || "#fff0b4");
          p.setAttribute("stroke-width", "3");
          p.setAttribute("stroke-linecap", "round");
          p.setAttribute("filter", `url(#lf-${bahnen.indexOf(bahn)})`);
          svg.appendChild(p);
          const L = p.getTotalLength();
          gesamt.push(L);
          p.setAttribute("stroke-dasharray", `${STRICH} ${L + STRICH}`);
          p.animate([{ strokeDashoffset: STRICH }, { strokeDashoffset: -L }], { duration: DAUER, iterations: Infinity, easing: "linear", delay: 1500 });
        }
        // Aufleuchten der Kreise, zeitlich passend zur Position des Lichts
        const L = gesamt[0];
        let extra = 0;
        for (const k of knoten) {
          const s = k.cx - x0 + extra + (Math.PI * k.r) / 2 - k.r;
          extra += Math.PI * k.r - 2 * k.r;
          const t = Math.min(0.999, Math.max(0.001, (s + STRICH / 2) / (L + STRICH)));
          const g = document.createElementNS(SVGNS, "circle");
          g.setAttribute("cx", String(k.cx)); g.setAttribute("cy", String(k.cy)); g.setAttribute("r", String(k.r * 1.9));
          g.setAttribute("fill", `url(#lg-${bahnen.indexOf(bahn)})`);
          g.style.opacity = "0";
          svg.insertBefore(g, svg.querySelector("path"));
          const a = Math.max(0, t - 0.05), e = Math.min(1, t + 0.09);
          g.animate([{ opacity: 0, offset: 0 }, { opacity: 0, offset: a }, { opacity: 1, offset: t }, { opacity: 0, offset: e }, { opacity: 0, offset: 1 }], { duration: DAUER, iterations: Infinity, easing: "linear", delay: 1500 });
        }
        bahn.appendChild(svg);
        bahn.classList.add("bahn-aktiv");
      };
      let bahnTimer = 0;
      const alleBahnen = () => bahnen.forEach(bahnBauen);
      addEventListener("resize", () => { clearTimeout(bahnTimer); bahnTimer = window.setTimeout(alleBahnen, 250); });
      ruhig.addEventListener("change", alleBahnen);
      // nach Schriften und Einblend-Animationen messen
      document.fonts?.ready.then(() => setTimeout(alleBahnen, 50));
      setTimeout(alleBahnen, 1800);

      // Videos: erst nach Klick von YouTube (youtube-nocookie) laden
      document.querySelectorAll<HTMLButtonElement>("[data-yt]").forEach((b) => {
        b.addEventListener("click", () => {
          const id = b.dataset.yt;
          if (!id) return;
          const f = document.createElement("iframe");
          f.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
          f.title = b.dataset.titel || "YouTube-Video";
          f.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
          f.allowFullscreen = true;
          f.className = "video-iframe";
          b.replaceWith(f);
        });
      });
    </script>
  </body>
</html>
