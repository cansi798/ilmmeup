---
// „Was entsteht“: die langfristige Vision als Ausblick – bewusst ohne eigene Unterseiten.
import Icon from "./Icon.astro";
const stufen = [
  { phase: "Heute", status: "aktiv", titel: "Medienplattform", text: "Gespräche, Impulse und Fachbeiträge – professionell produziert und auf YouTube, Instagram und TikTok veröffentlicht.", punkte: [["kamera", "Videoproduktion"], ["netz", "Social Media"], ["personen", "Expertennetzwerk"]] },
  { phase: "Als Nächstes", status: "in Planung", titel: "Wissen bündeln", text: "Inhalte geordnet auffindbar machen und Menschen auch offline zusammenbringen.", punkte: [["bibliothek", "Mediathek"], ["mikro", "Podcast"], ["kalender", "Veranstaltungen"]] },
  { phase: "Perspektivisch", status: "Vision", titel: "Gemeinschaft stärken", text: "Aus Reichweite wird Begleitung: Lernen, Austausch und Unterstützung für alle Generationen.", punkte: [["personen", "Community"], ["schule", "Bildungsangebote"], ["kompass", "Mentoring"], ["familie", "Familien- & Jugendarbeit"], ["hand", "Partner & Kooperationen"]] },
  { phase: "Langfristig", status: "Vision", titel: "Community Center", text: "Ein Ort für Begegnung, Lernen und gemeinschaftliches Engagement – offen für alle, die etwas bewegen wollen.", punkte: [["haus", "Ort der Begegnung"]] },
];
---
<ol class="roadmap" data-bahn>
  {stufen.map((s, i) => (
    <li class:list={["stufe reveal", { aktiv: i === 0 }]} style={`--v:${i * 110}ms`}>
      <div class="stufe-kopf">
        <span class="stufe-punkt" aria-hidden="true" data-knoten></span>
        <span class="stufe-label"><span class="stufe-phase">{s.phase}</span><span class="stufe-status">{s.status}</span></span>
      </div>
      <h3>{s.titel}</h3>
      <p>{s.text}</p>
      <ul class="stufe-liste">
        {s.punkte.map(([icon, label]) => <li><Icon name={icon} />{label}</li>)}
      </ul>
    </li>
  ))}
</ol>

<style>
  .roadmap { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; position: relative; }
  @media (min-width: 1000px) { .roadmap { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } .roadmap::before { content: ""; position: absolute; left: calc(50% - 50vw); right: calc(50% - 50vw); top: 11px; height: 2px; background: linear-gradient(90deg, rgba(255, 204, 0, 0.35), var(--gelb) 18%, rgba(255, 255, 255, 0.15) 50%, rgba(255, 255, 255, 0.08)); } }
  .stufe { position: relative; padding: 0 0 0 0; }
  @media (max-width: 999px) { .stufe { padding-left: 2rem; border-left: 2px solid rgba(255, 255, 255, 0.12); padding-bottom: 1.5rem; } .stufe.aktiv { border-left-color: var(--gelb); } .stufe-punkt { position: absolute; left: -12px; top: 0; } }
  .stufe-kopf { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1.4rem; flex-wrap: wrap; }
  .stufe-punkt { width: 22px; height: 22px; border-radius: 50%; background: var(--nacht); border: 2px solid rgba(255, 255, 255, 0.35); flex: none; position: relative; }
  .aktiv .stufe-punkt { background: var(--gelb); border-color: var(--gelb); box-shadow: 0 0 10px 2px rgba(255, 204, 0, 0.55); }
  /* Glimmen: weicher Lichthof, nur opacity/transform animiert */
  .aktiv .stufe-punkt::before, .aktiv .stufe-punkt::after { content: ""; position: absolute; inset: -2px; border-radius: 50%; pointer-events: none; }
  .aktiv .stufe-punkt::before { background: radial-gradient(circle, rgba(255, 220, 90, 0.75), rgba(255, 204, 0, 0) 70%); transform: scale(2.6); animation: glimmen 2.8s ease-in-out infinite; }
  .aktiv .stufe-punkt::after { border: 2px solid rgba(255, 204, 0, 0.6); animation: welle 2.8s ease-out infinite; }
  @keyframes glimmen { 0%, 100% { opacity: 0.45; transform: scale(2.2); } 50% { opacity: 1; transform: scale(3); } }
  @keyframes welle { 0% { opacity: 0.8; transform: scale(1); } 100% { opacity: 0; transform: scale(2.8); } }
  /* Glanz, der über die Zeitleiste läuft */
  .roadmap::after { content: ""; position: absolute; pointer-events: none; border-radius: 2px; background: linear-gradient(90deg, transparent, rgba(255, 240, 180, 0.95), transparent); box-shadow: 0 0 12px rgba(255, 220, 90, 0.6); }
  @media (min-width: 1000px) {
    .roadmap::after { left: calc(50% - 50vw); right: calc(50% - 50vw); top: 10px; height: 4px; box-shadow: none; filter: drop-shadow(0 0 4px rgba(255, 220, 90, 0.7)); background: linear-gradient(90deg, transparent, rgba(255, 240, 180, 1), transparent) no-repeat; background-size: 14% 100%; background-position: -20% 0; animation: glanz-x 7s cubic-bezier(0.45, 0, 0.25, 1) infinite; }
  }
  @media (max-width: 999px) {
    .roadmap::after { left: -1px; top: 0; bottom: 0; width: 4px; box-shadow: none; filter: drop-shadow(0 0 4px rgba(255, 220, 90, 0.7)); background: linear-gradient(180deg, transparent, rgba(255, 240, 180, 1), transparent) no-repeat; background-size: 100% 18%; background-position: 0 -20%; animation: glanz-y 7s cubic-bezier(0.45, 0, 0.25, 1) infinite; }
  }
  @keyframes glanz-x { 0% { background-position: -20% 0; } 80%, 100% { background-position: 120% 0; } }
  @keyframes glanz-y { 0% { background-position: 0 -20%; } 80%, 100% { background-position: 0 120%; } }
  @media (max-width: 999px) { .stufe .stufe-punkt { position: absolute; left: -12px; top: 0; } }
  .stufe-label { display: inline-flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  @media (min-width: 1000px) { .stufe-kopf { display: grid; justify-items: start; gap: 1.1rem; } }
  @media (prefers-reduced-motion: reduce) { .roadmap::after { display: none; } .aktiv .stufe-punkt::before { opacity: 0.7; } }
  .stufe-phase { font-weight: 800; color: #fff; letter-spacing: -0.01em; }
  .stufe-status { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.25em 0.7em; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.22); color: rgba(255, 255, 255, 0.75); }
  .aktiv .stufe-status { background: var(--gelb); color: var(--tinte); border-color: var(--gelb); }
  .stufe h3 { font-size: 1.45rem; margin-bottom: 0.5rem; }
  .stufe p { color: rgba(255, 255, 255, 0.72); font-size: 0.98rem; }
  .stufe-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .stufe-liste li { display: flex; align-items: center; gap: 0.6rem; font-size: 0.95rem; font-weight: 600; color: #fff; }
  .stufe-liste :global(svg) { width: 20px; height: 20px; color: var(--gelb); flex: none; }
  .stufe:not(.aktiv) .stufe-liste li { color: rgba(255, 255, 255, 0.8); }
</style>
