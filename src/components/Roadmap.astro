---
// „Was entsteht“: die langfristige Vision als Ausblick – bewusst ohne eigene Unterseiten.
// Ohne wanderndes Licht (Jamil 08.11.2026): Linie und Kreise statisch, „Heute“ leuchtet ruhig.
import Icon from "./Icon.astro";
import { u } from "../consts";
const stufen = [
  { phase: "Heute", status: "aktiv", titel: "Medienplattform", text: "Gespräche, Impulse und Fachbeiträge, professionell produziert und auf YouTube, Instagram und TikTok veröffentlicht.", punkte: [["kamera", "Videoproduktion"], ["netz", "Social Media"], ["personen", "Expertennetzwerk"]] },
  { phase: "Als Nächstes", status: "in Planung", titel: "Wissen bündeln", text: "Inhalte geordnet auffindbar machen und Menschen auch offline zusammenbringen.", punkte: [["bibliothek", "Mediathek", "/mediathek/"], ["mikro", "Podcast"], ["kalender", "Veranstaltungen"]] },
  { phase: "Perspektivisch", status: "Vision", titel: "Gemeinschaft stärken", text: "Aus Reichweite wird Begleitung: Lernen, Austausch und Unterstützung für alle Generationen.", punkte: [["personen", "Community"], ["schule", "Bildungsangebote"], ["kompass", "Mentoring"], ["familie", "Familien- & Jugendarbeit"], ["hand", "Partner & Kooperationen"]] },
  { phase: "Langfristig", status: "Vision", titel: "Community Center", text: "Ein Ort für Begegnung, Lernen und gemeinschaftliches Engagement, offen für alle, die etwas bewegen wollen.", punkte: [["haus", "Ort der Begegnung"]] },
];
---
<ol class="roadmap">
  {stufen.map((s, i) => (
    <li class:list={["stufe reveal", { aktiv: i === 0 }]} style={`--v:${i * 110}ms`}>
      <div class="stufe-kopf">
        <span class="stufe-punkt" aria-hidden="true" data-knoten></span>
        <span class="stufe-label"><span class="stufe-phase">{s.phase}</span><span class="stufe-status">{s.status}</span></span>
      </div>
      <h3>{s.titel}</h3>
      <p>{s.text}</p>
      <ul class="stufe-liste">
        {s.punkte.map(([icon, label, href]) => <li><Icon name={icon} />{href ? <a class="stufe-link" href={u(href)}><span class="stufe-link-text">{label}</span><span class="stufe-neu">Vorschau online</span></a> : label}</li>)}
      </ul>
    </li>
  ))}
</ol>

<style>
  .roadmap { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; position: relative; }
  @media (min-width: 1000px) { .roadmap { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } .roadmap::before { content: ""; position: absolute; left: calc(50% - 50vw); width: calc(50vw - 50% + (100% - 4.5rem) * 3 / 4 + 4.5rem + 11px); top: 11px; height: 2px; background: linear-gradient(90deg, rgba(255, 204, 0, 0.35), var(--gelb) 22%, rgba(255, 255, 255, 0.18) 55%, rgba(255, 255, 255, 0.14)); } }
  .stufe { position: relative; padding: 0 0 0 0; }
  /* Handy: eine durchgehende senkrechte Linie wie am PC – Stück für Stück von Kreismitte zu Kreismitte,
     endet am letzten Kreis. Linie und Kreise stehen fest; nur die Texte blenden beim Scrollen ein
     (vorher rutschten die ganzen Stufen samt Linienstück einzeln nach oben → Linie wirkte zerstückelt). */
  @media (max-width: 999px) {
    .stufe { padding: 0 0 1.5rem 2.4rem; }
    .stufe:not(:last-of-type)::before { content: ""; position: absolute; left: 10px; top: 11px; width: 2px; height: calc(100% + 1.25rem); background: linear-gradient(rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.1)); pointer-events: none; }
    .stufe.aktiv::before { background: linear-gradient(var(--gelb), var(--gelb) 55%, rgba(255, 255, 255, 0.16)) !important; }
    .stufe-kopf { min-height: 22px; }
    .stufe .stufe-punkt { position: absolute; left: 0; top: 0; z-index: 1; }
    :global(.js) .stufe.reveal { opacity: 1; transform: none; }
    :global(.js) .stufe.reveal :is(.stufe-label, h3, p, .stufe-liste) { transition: opacity 0.8s var(--kurve), transform 0.8s var(--kurve); transition-delay: var(--v, 0ms); }
    :global(.js) .stufe.reveal:not(.sichtbar) :is(.stufe-label, h3, p, .stufe-liste) { opacity: 0; transform: translateY(16px); }
    .stufe-kopf { margin-bottom: 1.1rem; }
  }
  .stufe-kopf { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1.4rem; flex-wrap: wrap; }
  .stufe-punkt { width: 22px; height: 22px; border-radius: 50%; background: var(--nacht); border: 2px solid rgba(255, 255, 255, 0.35); flex: none; position: relative; }
  .aktiv .stufe-punkt { background: var(--gelb); border-color: var(--gelb); box-shadow: 0 0 10px 2px rgba(255, 204, 0, 0.55); }
  /* „Heute“ leuchtet ruhig: weicher Lichthof ohne Bewegung */
  .aktiv .stufe-punkt::before { content: ""; position: absolute; inset: -2px; border-radius: 50%; pointer-events: none; background: radial-gradient(circle, rgba(255, 220, 90, 0.75), rgba(255, 204, 0, 0) 70%); transform: scale(2.6); opacity: 0.7; }
  .stufe-label { display: inline-flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  @media (min-width: 1000px) { .stufe-kopf { display: grid; justify-items: start; gap: 1.1rem; } }
  .stufe-phase { font-weight: 800; color: #fff; letter-spacing: -0.01em; }
  .stufe-status { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.25em 0.7em; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.22); color: rgba(255, 255, 255, 0.75); }
  .aktiv .stufe-status { background: var(--gelb); color: var(--tinte); border-color: var(--gelb); }
  .stufe h3 { font-size: 1.45rem; margin-bottom: 0.5rem; }
  .stufe p { color: rgba(255, 255, 255, 0.72); font-size: 0.98rem; }
  .stufe-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .stufe-liste li { display: flex; align-items: center; gap: 0.6rem; font-size: 0.95rem; font-weight: 600; color: #fff; }
  .stufe-liste :global(svg) { width: 20px; height: 20px; color: var(--gelb); flex: none; }
  .stufe:not(.aktiv) .stufe-liste li { color: rgba(255, 255, 255, 0.8); }
  .stufe-liste .stufe-link { display: inline-flex; align-items: center; gap: 0.55rem; color: #fff; text-decoration: none; min-height: 24px; }
  .stufe-link-text { text-decoration: underline; text-decoration-color: rgba(255, 204, 0, 0.6); text-underline-offset: 0.2em; }
  .stufe-link:hover .stufe-link-text { text-decoration-color: var(--gelb); }
  .stufe-neu { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tinte); background: var(--gelb); padding: 0.2em 0.55em; border-radius: 999px; text-decoration: none; }
</style>
