---
// Kanäle + „Aktuelle Beiträge“ ohne Live-Einbettung (keine Tracker). Beitragskacheln sind Platzhalter.
import Icon from "./Icon.astro";
import { SOCIAL } from "../consts";
---
<div class="kanaele">
  {SOCIAL.map((s, i) => (
    <a class:list={["kanal reveal", s.id]} href={s.url} target="_blank" rel="noopener" style={`--v:${i * 90}ms`}>
      <span class="kanal-icon"><Icon name={s.id} /></span>
      <span class="kanal-name">{s.name}</span>
      <span class="kanal-text">{s.text}</span>
      <span class="kanal-folgen">Kanal öffnen <Icon name="pfeil" /></span>
    </a>
  ))}
</div>



<style>
  .kanaele { display: grid; gap: 1rem; }
  @media (min-width: 800px) { .kanaele { grid-template-columns: repeat(3, 1fr); } }
  .kanal { position: relative; display: grid; gap: 0.35rem; padding: 1.75rem; border-radius: var(--radius); background: var(--weiss); border: 1px solid var(--linie); text-decoration: none; color: var(--text); overflow: hidden; transition: transform 0.35s var(--kurve), box-shadow 0.35s, border-color 0.35s; }
  .kanal:hover { transform: translateY(-4px); box-shadow: var(--schatten); border-color: transparent; color: var(--text); }
  .kanal-icon { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; background: var(--nacht); color: #fff; margin-bottom: 0.8rem; transition: background 0.3s, color 0.3s; }
  .kanal-icon :global(svg) { width: 28px; height: 28px; }
  .kanal:hover .kanal-icon { background: var(--gelb); color: var(--tinte); }
  .kanal-name { font-weight: 800; font-size: 1.35rem; color: var(--tinte); letter-spacing: -0.02em; }
  .kanal-text { color: var(--leise); font-size: 0.98rem; }
  .kanal-folgen { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--petrol); margin-top: 0.6rem; }
  .kanal-folgen :global(svg) { width: 1em; height: 1em; transition: transform 0.25s; }
  .kanal:hover .kanal-folgen :global(svg) { transform: translateX(3px); }
</style>
